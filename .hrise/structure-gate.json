{
  "file": {
    "warn_lines": 500,
    "max_lines": 800,
    "test_warn_lines": 900,
    "test_max_lines": 1500
  },
  "function": {
    "warn_lines": 90,
    "max_lines": 140,
    "test_warn_lines": 180,
    "test_max_lines": 280
  },
  "package": {
    "warn_files": 18,
    "max_files": 30
  },
  "naming": {
    "require_business_role_for_new_files": true,
    "weak_names": [
      "service.go",
      "handler.go",
      "dto.go",
      "provider.go",
      "repository.go",
      "router.go",
      "config.go",
      "types.go",
      "model.go",
      "callbacks.go",
      "catalog.go",
      "query.go",
      "builder.go",
      "validator.go"
    ]
  },
  "baseline": {
    "path": ".hrise/structure-gate-baseline.json"
  },
  "exclude": {
    "generated": true,
    "paths": [
      "vendor/**",
      ".codegraph/**",
      "build/**",
      "dist/**",
      "tmp/**",
      ".tmp/**",
      "tools/go-structure-gate/**"
    ]
  },
  "overrides": [
    {
      "paths": ["cmd/**/*.go"],
      "file": {
        "warn_lines": 650,
        "max_lines": 1000
      },
      "function": {
        "warn_lines": 120,
        "max_lines": 190
      },
      "package": {
        "warn_files": 22,
        "max_files": 35
      }
    },
    {
      "paths": ["internal/generator/**/*.go"],
      "file": {
        "warn_lines": 650,
        "max_lines": 1100,
        "test_warn_lines": 1000,
        "test_max_lines": 1700
      },
      "function": {
        "warn_lines": 130,
        "max_lines": 220,
        "test_warn_lines": 220,
        "test_max_lines": 360
      },
      "package": {
        "warn_files": 35,
        "max_files": 55
      }
    }
  ]
}
