## 🚀 Step 3: 创建认证 Handler

创建文件 `internal/module/auth/handler.go`：

```go
package auth

import (
    "net/http"
    
    "github.com/gin-gonic/gin"
    "github.com/KOMKZ/go-yogan-framework/jwt"
    "github.com/KOMKZ/go-yogan-framework/httpx"
)

// Handler 认证处理器
type Handler struct {
    jwtManager jwt.TokenManager
}

// NewHandler 创建处理器
func NewHandler(jwtManager jwt.TokenManager) *Handler {
    return &Handler{jwtManager: jwtManager}
}

// LoginRequest 登录请求
type LoginRequest struct {
    Username string `json:"username" binding:"required"`
    Password string `json:"password" binding:"required"`
}

// Login 登录
func (h *Handler) Login(c *gin.Context) {
    var req LoginRequest
    if err := c.ShouldBindJSON(&req); err != nil {
        httpx.Error(c, http.StatusBadRequest, "参数错误")
        return
    }
    
    // TODO: 验证用户名密码（这里只是示例）
    if req.Username != "admin" || req.Password != "123456" {
        httpx.Error(c, http.StatusUnauthorized, "用户名或密码错误")
        return
    }
    
    // 生成 Token
    ctx := c.Request.Context()
    claims := &jwt.Claims{
        UserID:   1,
        Username: req.Username,
        Role:     "admin",
    }
    
    tokenPair, err := h.jwtManager.Generate(ctx, claims)
    if err != nil {
        httpx.Error(c, http.StatusInternalServerError, "生成 Token 失败")
        return
    }
    
    httpx.Success(c, gin.H{
        "access_token":  tokenPair.AccessToken,
{{- if .Config.enable_refresh_token}}
        "refresh_token": tokenPair.RefreshToken,
{{- end}}
        "expires_in":    tokenPair.ExpiresIn,
    })
}

// Logout 登出
func (h *Handler) Logout(c *gin.Context) {
    // 从 Header 获取 Token
    token := c.GetHeader("Authorization")
    if len(token) > 7 && token[:7] == "Bearer " {
        token = token[7:]
    }
    
    ctx := c.Request.Context()
    if err := h.jwtManager.Revoke(ctx, token); err != nil {
        httpx.Error(c, http.StatusInternalServerError, "登出失败")
        return
    }
    
    httpx.Success(c, gin.H{"message": "登出成功"})
}

{{- if .Config.enable_refresh_token}}

// RefreshRequest 刷新请求
type RefreshRequest struct {
    RefreshToken string `json:"refresh_token" binding:"required"`
}

// Refresh 刷新 Token
func (h *Handler) Refresh(c *gin.Context) {
    var req RefreshRequest
    if err := c.ShouldBindJSON(&req); err != nil {
        httpx.Error(c, http.StatusBadRequest, "参数错误")
        return
    }
    
    ctx := c.Request.Context()
    tokenPair, err := h.jwtManager.Refresh(ctx, req.RefreshToken)
    if err != nil {
        httpx.Error(c, http.StatusUnauthorized, "Refresh Token 无效或已过期")
        return
    }
    
    httpx.Success(c, gin.H{
        "access_token":  tokenPair.AccessToken,
        "refresh_token": tokenPair.RefreshToken,
        "expires_in":    tokenPair.ExpiresIn,
    })
}
{{- end}}

// GetCurrentUser 获取当前用户
func (h *Handler) GetCurrentUser(c *gin.Context) {
    // 从上下文获取用户信息（由 JWT 中间件设置）
    claims, exists := c.Get("claims")
    if !exists {
        httpx.Error(c, http.StatusUnauthorized, "未登录")
        return
    }
    
    httpx.Success(c, claims)
}
```

