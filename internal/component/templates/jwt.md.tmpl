## 🚀 Step 5: 注册路由

打开或创建 `internal/router/auth.go`：

```go
package router

import (
    "github.com/gin-gonic/gin"
    "github.com/KOMKZ/go-yogan-framework/application"
    "github.com/KOMKZ/go-yogan-framework/component"
    jwtcomp "github.com/KOMKZ/go-yogan-framework/jwt"
    
    "your-app/internal/middleware"
    "your-app/internal/module/auth"
)

func RegisterAuthRoutes(engine *gin.Engine, app *application.Application) {
    // 1. 获取 JWT 组件
    jwtComp, ok := app.GetRegistry().Get(component.ComponentJWT)
    if !ok {
        panic("jwt component not found")
    }
    
    // 2. 获取 TokenManager
    jwtManager := jwtComp.(*jwtcomp.Component).GetTokenManager()
    
    // 3. 创建 Handler
    authHandler := auth.NewHandler(jwtManager)
    
    // 4. 公开路由（无需认证）
    public := engine.Group("/api/auth")
    {
        public.POST("/login", authHandler.Login)
{{- if .Config.enable_refresh_token}}
        public.POST("/refresh", authHandler.Refresh)
{{- end}}
    }
    
    // 5. 需要认证的路由
    protected := engine.Group("/api")
    protected.Use(middleware.JWTAuth(jwtManager))
    {
        protected.POST("/auth/logout", authHandler.Logout)
        protected.GET("/auth/me", authHandler.GetCurrentUser)
    }
}
```

