## 🚀 Step 4: 配置 JWT 中间件

创建文件 `internal/middleware/jwt.go`：

```go
package middleware

import (
    "net/http"
    "strings"
    
    "github.com/gin-gonic/gin"
    "github.com/KOMKZ/go-yogan-framework/jwt"
    "github.com/KOMKZ/go-yogan-framework/httpx"
)

// JWTAuth JWT 认证中间件
func JWTAuth(jwtManager jwt.TokenManager) gin.HandlerFunc {
    return func(c *gin.Context) {
        // 获取 Token
        authHeader := c.GetHeader("Authorization")
        if authHeader == "" {
            httpx.Error(c, http.StatusUnauthorized, "缺少 Authorization Header")
            c.Abort()
            return
        }
        
        // 解析 Bearer Token
        parts := strings.SplitN(authHeader, " ", 2)
        if len(parts) != 2 || parts[0] != "Bearer" {
            httpx.Error(c, http.StatusUnauthorized, "Authorization 格式错误")
            c.Abort()
            return
        }
        
        token := parts[1]
        
        // 验证 Token
        ctx := c.Request.Context()
        claims, err := jwtManager.Verify(ctx, token)
        if err != nil {
            httpx.Error(c, http.StatusUnauthorized, "Token 无效或已过期")
            c.Abort()
            return
        }
        
        // 存储用户信息到上下文
        c.Set("claims", claims)
        c.Set("user_id", claims.UserID)
        c.Set("username", claims.Username)
        c.Set("role", claims.Role)
        
        c.Next()
    }
}
```

