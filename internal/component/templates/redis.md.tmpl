## 🚀 Step 5: 在路由中使用

打开或创建 `internal/router/cache.go`：

```go
package router

import (
    "github.com/gin-gonic/gin"
    "github.com/KOMKZ/go-yogan-framework/application"
    "github.com/KOMKZ/go-yogan-framework/component"
    "github.com/KOMKZ/go-yogan-framework/redis"
    
    "your-app/internal/service/cache"
)

func RegisterCacheRoutes(engine *gin.Engine, app *application.Application) {
    // 1. 从 Registry 获取 Redis 组件
    redisComp, ok := app.GetRegistry().Get(component.ComponentRedis)
    if !ok {
        panic("redis component not found")
    }
    
    // 2. 获取 Redis Client
    client := redisComp.(*redis.Component).GetManager().Client("{{.Config.instance_name}}")
    
    // 3. 创建缓存服务
    cacheService := cache.NewService(client)
    
    // 4. 注册示例路由
    api := engine.Group("/api/cache")
    {
        api.GET("/demo", func(c *gin.Context) {
            ctx := c.Request.Context()
            
            // 尝试从缓存获取
            var data map[string]interface{}
            err := cacheService.Get(ctx, "demo:key", &data)
            if err == nil {
                c.JSON(200, gin.H{"source": "cache", "data": data})
                return
            }
            
            // 缓存未命中，从数据库获取（模拟）
            data = map[string]interface{}{
                "id":   1,
                "name": "demo",
            }
            
            // 写入缓存
            _ = cacheService.Set(ctx, "demo:key", data, 5*time.Minute)
            
            c.JSON(200, gin.H{"source": "db", "data": data})
        })
    }
}
```

