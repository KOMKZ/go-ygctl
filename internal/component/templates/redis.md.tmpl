## 🚀 Step 3: 创建缓存服务

创建文件 `internal/service/cache/cache.go`：

```go
package cache

import (
    "context"
    "encoding/json"
    "time"
    
    goredis "github.com/redis/go-redis/v9"
)

// Service 缓存服务
type Service struct {
    client *goredis.Client
}

// NewService 创建缓存服务
func NewService(client *goredis.Client) *Service {
    return &Service{client: client}
}

// Set 设置缓存
func (s *Service) Set(ctx context.Context, key string, value interface{}, expiration time.Duration) error {
    data, err := json.Marshal(value)
    if err != nil {
        return err
    }
    return s.client.Set(ctx, key, data, expiration).Err()
}

// Get 获取缓存
func (s *Service) Get(ctx context.Context, key string, dest interface{}) error {
    data, err := s.client.Get(ctx, key).Bytes()
    if err != nil {
        return err
    }
    return json.Unmarshal(data, dest)
}

// Delete 删除缓存
func (s *Service) Delete(ctx context.Context, keys ...string) error {
    return s.client.Del(ctx, keys...).Err()
}

// Exists 检查 key 是否存在
func (s *Service) Exists(ctx context.Context, key string) (bool, error) {
    n, err := s.client.Exists(ctx, key).Result()
    return n > 0, err
}

// SetNX 仅当 key 不存在时设置 (用于分布式锁)
func (s *Service) SetNX(ctx context.Context, key string, value interface{}, expiration time.Duration) (bool, error) {
    data, err := json.Marshal(value)
    if err != nil {
        return false, err
    }
    return s.client.SetNX(ctx, key, data, expiration).Result()
}
```

