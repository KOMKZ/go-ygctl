## 🚀 Step 5: 在路由中使用

打开或创建 `internal/router/user.go`：

```go
package router

import (
    "github.com/gin-gonic/gin"
    "github.com/KOMKZ/go-yogan-framework/application"
    "github.com/KOMKZ/go-yogan-framework/component"
    "github.com/KOMKZ/go-yogan-framework/database"
    
    userDomain "your-app/internal/domain/user"
    userModule "your-app/internal/module/user"
)

func RegisterUserRoutes(engine *gin.Engine, app *application.Application) {
    // 1. 从 Registry 获取 Database 组件
    dbComp, ok := app.GetRegistry().Get(component.ComponentDatabase)
    if !ok {
        panic("database component not found")
    }
    
    // 2. 类型断言获取 Manager
    db := dbComp.(*database.Component).GetManager().DB("{{.Config.conn_name}}")
    
    // 3. 创建 Repository
    userRepo := userDomain.NewDBRepository(db)
    
    // 4. 创建 Service
    userService := userDomain.NewService(userRepo)
    
    // 5. 创建 Handler
    userHandler := userModule.NewHandler(userService)
    
    // 6. 注册路由
    api := engine.Group("/api/users")
    {
        api.POST("", userHandler.Create)
        api.GET("/:id", userHandler.Get)
        api.PUT("/:id", userHandler.Update)
        api.DELETE("/:id", userHandler.Delete)
        api.GET("", userHandler.List)
    }
}
```

