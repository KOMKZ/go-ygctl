package main

import (
	"{{.ModuleName}}/internal/app"
	"github.com/KOMKZ/go-yogan-framework/logger"
	"go.uber.org/zap"
)

// Version is the current {{.AppName}} version. It is injected at build time
// by scripts/build.sh via -ldflags — keep it a var, not a const (the linker
// silently ignores -X targeting consts).
var Version = "0.1.0"

// BuildTime is injected by scripts/build.sh via -ldflags.
var BuildTime = ""

// GitCommit is injected by scripts/build.sh via -ldflags.
var GitCommit = ""

var executeCLI = func() error {
	return app.New().Execute()
}

var fatalCLI = func(err error) {
	logger.Fatal("main", "CLI application failed", zap.Error(err))
}

func main() {
	if err := executeCLI(); err != nil {
		fatalCLI(err)
	}
}
