package main

import (
	"{{.ModuleName}}/internal/app"
	"github.com/KOMKZ/go-yogan-framework/logger"
	"go.uber.org/zap"
)

// Version is the current {{.AppName}} version.
var Version = "0.1.0"

func main() {
	application := app.New()

	if err := application.Execute(); err != nil {
		logger.Fatal("main", "CLI application failed", zap.Error(err))
	}
}
