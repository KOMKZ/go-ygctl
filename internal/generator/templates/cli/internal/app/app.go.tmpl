package app

import (
	"{{.ModuleName}}/internal/command"
	"github.com/KOMKZ/go-yogan-framework/application"
	"github.com/KOMKZ/go-yogan-framework/logger"
	"github.com/spf13/cobra"
)

// {{.AppNamePascal}} is a CLI application hosted by the {{.ProjectName}} workspace.
type {{.AppNamePascal}} struct {
	Core       *application.CLIApplication
	configPath string
	logger     *logger.CtxZapLogger
}

// New creates an application with the default config directory.
func New() *{{.AppNamePascal}} {
	return NewWithConfig("./config")
}

// NewWithConfig creates an application with an explicit config directory.
func NewWithConfig(configPath string) *{{.AppNamePascal}} {
	core := application.NewCLI(configPath, "{{.AppNameUpper}}", command.NewRootCmd())
	command.RegisterModules(core.GetRootCmd(), core.GetInjector())
	return &{{.AppNamePascal}}{
		configPath: configPath,
		Core:       core,
		logger:     logger.GetLogger("{{.AppNameSnake}}"),
	}
}

// Execute runs the CLI command synchronously (cleans up resources on exit).
func (a *{{.AppNamePascal}}) Execute() error {
	a.Core.OnReady(a.onReady)
	return a.Core.Execute()
}

// GetRootCmd returns the root cobra command (for tests).
func (a *{{.AppNamePascal}}) GetRootCmd() *cobra.Command {
	return a.Core.GetRootCmd()
}

// onReady runs after the application finishes setup.
func (a *{{.AppNamePascal}}) onReady(core *application.CLIApplication) error {
	a.logger.DebugCtx(core.Context(), "{{.AppNamePascal}} ready")
	return nil
}
