// Package app command registration
package app

import (
	"{{.ModuleName}}/internal/command"
	"github.com/KOMKZ/go-yogan-framework/application"
)

// RegisterCommands registers all commands
//
// Commands are registered in OnSetup callback to ensure components are initialized
func (c *{{.AppNamePascal}}App) RegisterCommands() {
	c.Core.OnSetup(func(core *application.CLIApplication) error {
		// Register home command (demo)
		command.RegisterHomeCommands(c.rootCmd, core)

		// Add more commands here:
		// command.RegisterXxxCommands(c.rootCmd, core)

		return nil
	})
}
