package command

import (
	"github.com/spf13/cobra"
)

// NewRootCmd builds the root command of {{.AppName}}.
func NewRootCmd() *cobra.Command {
	rootCmd := &cobra.Command{
		Use:   "{{.AppName}}",
		Short: "{{.Description}}",
		RunE: func(cmd *cobra.Command, args []string) error {
			cmd.Println("hello from {{.AppName}}")
			return nil
		},
	}
	rootCmd.AddCommand(newHomeCmd())
	return rootCmd
}

// newHomeCmd builds the home subcommand.
func newHomeCmd() *cobra.Command {
	return &cobra.Command{
		Use:   "home",
		Short: "Print the home greeting",
		RunE: func(cmd *cobra.Command, args []string) error {
			cmd.Println("hello from home")
			return nil
		},
	}
}
