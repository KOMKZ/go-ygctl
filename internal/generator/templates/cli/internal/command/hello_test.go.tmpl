package command

import (
	"bytes"
	"strings"
	"testing"
)

func TestHelloCommand(t *testing.T) {
	root := NewRootCmd()
	var out bytes.Buffer
	root.SetOut(&out)
	root.SetErr(&out)
	root.SetArgs([]string{"hello"})

	if err := root.Execute(); err != nil {
		t.Fatalf("Execute() err = %v", err)
	}
	if strings.TrimSpace(out.String()) != "hello world" {
		t.Fatalf("output = %q, want hello world", out.String())
	}
}

func TestRootCommandShowsHelp(t *testing.T) {
	root := NewRootCmd()
	var out bytes.Buffer
	root.SetOut(&out)
	root.SetErr(&out)
	root.SetArgs([]string{})

	if err := root.Execute(); err != nil {
		t.Fatalf("Execute() err = %v", err)
	}
	if !strings.Contains(out.String(), "Available Commands") {
		t.Fatalf("help output missing command list:\n%s", out.String())
	}
}
