<template>
  <div class="ra-page" data-testid="[[.Entity]]-edit-page">
    <div class="ra-card">
      <RFormRenderer
        ref="formRef"
        :schema="editSchema"
        :model="model"
        :label-width="120"
        :cols="1"
        data-testid="[[.Entity]]-edit-form"
        @update:model="handleModelChange"
      />
      <n-space justify="end" class="form-actions">
        <n-button data-testid="[[.Entity]]-edit-cancel" @click="goBack">取消</n-button>
        <n-button
          type="primary"
          :loading="submitting"
          data-testid="[[.Entity]]-edit-submit"
          @click="handleSubmit"
        >
          保存
        </n-button>
      </n-space>
    </div>
  </div>
</template>

<script setup lang="ts">
// 由 ygctl web gen 生成（[[.Style]] 风格）。勿手改；重新生成会覆盖。
import { ref, reactive, onMounted } from 'vue'
import { useRouter, useRoute } from 'vue-router'
import { NSpace, NButton, useMessage } from '@rong/admin-ui/naive'
import { RFormRenderer } from '@rong/admin-ui'
import type { FormFieldSchema, FormRendererExpose } from '@rong/admin-ui'
import type { [[.EntityPascal]]FormModel } from '@/api/[[.Entity]]'
import { create[[.EntityPascal]]Api } from '@/api/[[.Entity]]'
import { getHttpClient } from '@/app'
import { parseErrorMessage } from '@/api/adapter'

const router = useRouter()
const route = useRoute()
const message = useMessage()

// httpClient 必须在 setup 阶段获取（inject 仅 setup/生命周期内有效）
const httpClient = getHttpClient()

const formRef = ref<FormRendererExpose | null>(null)
const submitting = ref(false)
const loadingDetail = ref(true)

const model = reactive<Record<string, unknown>>({
[[.EmptyModelTS]]})

const editSchema: FormFieldSchema[] = [
[[.EditSchemaTS]]]

function handleModelChange(next: Record<string, unknown>) {
  Object.assign(model, next)
}

function goBack() {
  router.push({ name: '[[.RouteName]]' })
}

async function loadDetail() {
  const id = Number(route.params.id)
  if (!Number.isFinite(id)) {
    message.error('参数错误')
    goBack()
    return
  }
  try {
    // 编辑前拉取详情完整 DTO（模板铁律）
    const detail = await create[[.EntityPascal]]Api(httpClient).getById(id)
    Object.assign(model, {
[[.RecordFillAssignmentsTS]]    })
  } catch (error) {
    message.error(parseErrorMessage(error) || '获取详情失败')
    goBack()
  } finally {
    loadingDetail.value = false
  }
}

async function handleSubmit() {
  const valid = (await formRef.value?.validate()) ?? false
  if (!valid) return
  const id = Number(route.params.id)
  submitting.value = true
  try {
    await create[[.EntityPascal]]Api(httpClient).update(id, model as unknown as [[.EntityPascal]]FormModel)
    message.success('保存成功')
    goBack()
  } catch (error) {
    message.error(parseErrorMessage(error) || '操作失败')
  } finally {
    submitting.value = false
  }
}

onMounted(() => {
  void loadDetail()
})
</script>

