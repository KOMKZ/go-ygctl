<template>
  <aside class="admin-sider" :class="{ 'admin-sider--collapsed': collapsed }">
    <div class="sider-header">
      <div class="logo">
        <span v-if="!collapsed" class="logo-text">[[.AppTitle]]</span>
        <span v-else class="logo-icon">H</span>
      </div>
    </div>
    <n-menu
      :collapsed="collapsed"
      :collapsed-width="64"
      :collapsed-icon-size="22"
      :options="menuOptions"
      :value="activeMenu"
      class="sider-menu"
      @update:value="(key: string) => emit('select', key)"
    />
    <div class="sider-footer">
      <button class="sider-trigger" aria-label="切换侧边栏" @click="emit('update:collapsed', !collapsed)">
        <n-icon :size="14"><ChevronLeftIcon v-if="!collapsed" /><ChevronRightIcon v-else /></n-icon>
      </button>
    </div>
  </aside>
</template>

<script setup lang="ts">
import { h, computed, type Component } from 'vue'
import { type MenuOption, NIcon } from '@rong/admin-ui/naive'
import { LayoutDashboard, Users, FileText, ChevronLeft as ChevronLeftIcon, ChevronRight as ChevronRightIcon } from 'lucide-vue-next'
import { staticRoutes } from '@/router'

defineProps<{
  collapsed: boolean
  activeMenu: string
}>()

const emit = defineEmits<{
  'update:collapsed': [value: boolean]
  select: [key: string]
}>()

const iconMap: Record<string, Component> = {
  LayoutDashboard,
  // @ygctl-web-gen:icons - 由 ygctl web gen 管理，勿手改
  Users,
  // @ygctl-web-gen:icons:end
}

function renderIcon(iconName: string) {
  const IconComponent = iconMap[iconName] || FileText
  return () => h(NIcon, null, { default: () => h(IconComponent) })
}

/**
 * 侧边栏菜单由静态路由生成（AdminLayout 的子路由）。
 * 接入后端菜单/权限过滤时，可在此处替换数据源。
 */
const menuOptions = computed<MenuOption[]>(() => {
  const layoutRoute = staticRoutes.find((r) => r.name === 'Layout')
  const children = (layoutRoute?.children ?? []) as Array<{
    name?: string
    meta?: { title?: string; icon?: string }
  }>

  return children.map((child) => {
    const option: MenuOption = {
      key: String(child.name),
      label: String(child.meta?.title || child.name),
    }
    if (child.meta?.icon) {
      option.icon = renderIcon(child.meta.icon)
    }
    return option
  })
})
</script>

