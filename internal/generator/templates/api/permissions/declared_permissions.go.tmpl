package permissions

// DeclaredPermissions 是 {{.DomainKey}} 域的权限码契约（由 ygctl api gen 生成）。
// 权限码字典由域声明，API 侧自动 upsert，禁止在 app 侧手工维护权限 SQL。
// 权限名来自 def endpoints 的 name 字段（缺省为 "<entity> <action> 权限"）。
var DeclaredPermissions = map[string]string{
{{- range .Endpoints}}
	"{{$.DomainKey}}:{{.Action}}": "{{.Name}}",
{{- end}}
}
