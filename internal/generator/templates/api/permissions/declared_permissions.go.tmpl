// Code generated by ygctl from defs/permissions/*.yaml; DO NOT EDIT.
//
// To change permissions or API policies, update the DSL file under
// defs/permissions/ and rerun ygctl api gen or ygctl api sync.

package permissions

import frameworkpermission "github.com/KOMKZ/go-yogan-framework/permission"

// DeclaredPermissions is generated from defs/permissions/*.yaml.
var DeclaredPermissions = []frameworkpermission.DeclaredPermission{
{{- range .Permissions}}
	{
		PermissionCode: "{{.Code}}",
		PermissionName: "{{.Name}}",
		PermissionType: "{{.Type}}",
		GroupCode:      "{{.Group}}",
		Description:    "{{.Description}}",
	},
{{- end}}
}

// DeclaredPolicies binds API resources to permission codes from defs/permissions/*.yaml.
var DeclaredPolicies = []frameworkpermission.RoutePolicy{
{{- range .Policies}}
	{
		Method:         "{{.Method}}",
		PathPattern:    "{{.Path}}",
		PermissionCode: "{{.PermissionCode}}",
	},
{{- end}}
}
