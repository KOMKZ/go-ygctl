package {{.EntitySnake}}

import "{{.PermMetaImport}}"

// RouteMeta 是路由权限元数据（由 ygctl api gen 生成）：权限中台资源扫描时按
// "METHOD /path" 合并，为 sys_api_resources 提供名称与描述（缺省值见 def endpoints）。
var RouteMeta = permmeta.RouteMeta{
{{- range .Endpoints}}
{{- if eq .Action "list"}}
	"GET /api/{{$.TableName}}/page": {Name: "{{.Name}}", Description: "{{.Description}}"},
{{- else if eq .Action "get"}}
	"GET /api/{{$.TableName}}/:id": {Name: "{{.Name}}", Description: "{{.Description}}"},
{{- else if eq .Action "create"}}
	"POST /api/{{$.TableName}}": {Name: "{{.Name}}", Description: "{{.Description}}"},
{{- else if eq .Action "update"}}
	"PUT /api/{{$.TableName}}/:id": {Name: "{{.Name}}", Description: "{{.Description}}"},
{{- else if eq .Action "delete"}}
	"DELETE /api/{{$.TableName}}/:id": {Name: "{{.Name}}", Description: "{{.Description}}"},
{{- end}}
{{- end}}
}
