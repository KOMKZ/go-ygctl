package {{.AppModuleSnake}}

import (
	"time"
	"{{.DomainImport}}/service"
	"github.com/KOMKZ/go-yogan-framework/httpx/types"
{{- if .HasValidate}}
	validation "github.com/go-ozzo/ozzo-validation/v4"
{{- if .HasEmailRule}}
	"github.com/go-ozzo/ozzo-validation/v4/is"
{{- end}}
{{- end}}
)

// 本文件定义 HTTP 请求/响应 DTO，避免把 service 层结构体直接暴露成 JSON 契约。
// 请求 DTO 实现 Validate()（框架 Validatable 接口），httpx.Wrap 自动调用。

// List{{.EntityPascal}}Request is the request payload of GET /api/{{.TableName}}/page.
type List{{.EntityPascal}}Request struct {
	Current int `form:"current" json:"current"`
	Size    int `form:"size" json:"size"`
}

// ApplyDefaults fills default pagination values.
func (r *List{{.EntityPascal}}Request) ApplyDefaults() {
	if r.Current <= 0 {
		r.Current = 1
	}
	if r.Size <= 0 {
		r.Size = 10
	}
}

// {{.EntityPascal}}GetRequest is the request payload of GET /api/{{.TableName}}/:id.
type {{.EntityPascal}}GetRequest struct {
	ID uint `uri:"id" binding:"required"`
}

// Create{{.EntityPascal}}Request is the request payload of POST /api/{{.TableName}}.
type Create{{.EntityPascal}}Request struct {
{{- range .Fields}}
	{{.PascalName}} {{.GoType}} `json:"{{.Name}}"`{{if .Comment}} // {{.Comment}}{{end}}
{{- end}}
}

// {{.EntityPascal}}UpdateRequest is the request payload of PUT /api/{{.TableName}}/:id.
type {{.EntityPascal}}UpdateRequest struct {
	ID uint `uri:"id" binding:"required"`
{{- range .Fields}}
	{{.PascalName}} {{.GoType}} `json:"{{.Name}}"`{{if .Comment}} // {{.Comment}}{{end}}
{{- end}}
}

{{if .HasValidate}}
// Validate implements the framework Validatable interface (httpx auto-invokes).
func (r *Create{{.EntityPascal}}Request) Validate() error {
	return validation.ValidateStruct(r,
{{- range .Fields}}
{{- if .ValidationRules}}
		validation.Field(&r.{{.PascalName}}, {{join .ValidationRules ", "}}),
{{- end}}
{{- end}}
	)
}

// Validate implements the framework Validatable interface (httpx auto-invokes).
func (r *{{.EntityPascal}}UpdateRequest) Validate() error {
	return validation.ValidateStruct(r,
{{- range .Fields}}
{{- if .ValidationRules}}
		validation.Field(&r.{{.PascalName}}, {{join .ValidationRules ", "}}),
{{- end}}
{{- end}}
	)
}
{{end}}

// {{.EntityPascal}}DeleteRequest is the request payload of DELETE /api/{{.TableName}}/:id.
type {{.EntityPascal}}DeleteRequest struct {
	ID uint `uri:"id" binding:"required"`
}

// {{.EntityPascal}}DeleteResponse is the response payload of the delete endpoint.
type {{.EntityPascal}}DeleteResponse struct {
	ID uint `json:"id"`
}

// {{.EntityPascal}}PageResponse is the response payload of the list endpoint.
type {{.EntityPascal}}PageResponse struct {
	PageMeta types.PageMeta        `json:"page_meta"`
	Records  []{{.EntityPascal}}Response `json:"records"`
}

// {{.EntityPascal}}Response is the response payload of one {{.EntityName}}.
type {{.EntityPascal}}Response struct {
	ID uint `json:"id"`
{{- range .Fields}}
	{{.PascalName}} {{.GoType}} `json:"{{.Name}}"`
{{- end}}
	CreatedAt time.Time `json:"created_at"`
	UpdatedAt time.Time `json:"updated_at"`
}

func to{{.EntityPascal}}Response(item *service.{{.EntityPascal}}Item) *{{.EntityPascal}}Response {
	if item == nil {
		return nil
	}
	return &{{.EntityPascal}}Response{
		ID: item.ID,
{{- range .Fields}}
		{{.PascalName}}: item.{{.PascalName}},
{{- end}}
		CreatedAt: item.CreatedAt,
		UpdatedAt: item.UpdatedAt,
	}
}

func to{{.EntityPascal}}Responses(items []service.{{.EntityPascal}}Item) []{{.EntityPascal}}Response {
	responses := make([]{{.EntityPascal}}Response, 0, len(items))
	for i := range items {
		responses = append(responses, *to{{.EntityPascal}}Response(&items[i]))
	}
	return responses
}
