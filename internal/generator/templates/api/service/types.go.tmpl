// 实现位于 cache 子包；service 只表达“记忆领域行集合”，不接触 Redis、key、TTL 或序列化细节。
type {{.EntityPascal}}RowsCache interface {
	Remember{{.EntityPascal}}Rows(ctx context.Context, scope string, loader func(context.Context) ([]model.{{.EntityPascal}}, error)) ([]model.{{.EntityPascal}}, error)
	Invalidate{{.EntityPascal}}Rows(ctx context.Context, scope string)
}
