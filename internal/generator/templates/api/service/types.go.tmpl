{{- range .Fields}}
	{{.PascalName}} {{.GoType}}
{{- end}}
}

// Update{{.EntityPascal}}Input is the input of Update.
type Update{{.EntityPascal}}Input struct {
	ID uint
{{- range .Fields}}
	{{.PascalName}} {{.GoType}}
{{- end}}
}

// {{.EntityPascal}}Item is the public representation of one {{.EntityName}}.
