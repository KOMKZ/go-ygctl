// {{.MethodName}} queries by the {{.ColumnName}} column.
func (r *{{$.EntityPascal}}MySQLRepository) {{.MethodName}}(ctx context.Context, {{.ParamName}} {{.ParamType}}) (*model.{{$.EntityPascal}}, error) {
	var e model.{{$.EntityPascal}}
	result := r.base.DB().WithContext(ctx).Where("{{.ColumnName}} = ?", {{.ParamName}}).First(&e)
	if errors.Is(result.Error, gorm.ErrRecordNotFound) {
