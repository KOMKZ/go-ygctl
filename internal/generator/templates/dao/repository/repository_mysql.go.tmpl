// {{.EntityPascal}}MySQLRepository 基于 database.BaseRepository 的 MySQL 实现（由 ygctl dao gen 生成）。
type {{.EntityPascal}}MySQLRepository struct {
	base *database.BaseRepository[model.{{.EntityPascal}}]
}

// New{{.EntityPascal}}MySQLRepository creates the MySQL repository.
func New{{.EntityPascal}}MySQLRepository(db *gorm.DB) *{{.EntityPascal}}MySQLRepository {
	return &{{.EntityPascal}}MySQLRepository{base: database.NewBaseRepository[model.{{.EntityPascal}}](db)}
}

func (r *{{.EntityPascal}}MySQLRepository) Create(ctx context.Context, e *model.{{.EntityPascal}}) error {
	return r.base.Create(ctx, e)
}

func (r *{{.EntityPascal}}MySQLRepository) FindByID(ctx context.Context, id uint) (*model.{{.EntityPascal}}, error) {
	result, err := r.base.FindByID(ctx, id)
	if errors.Is(err, database.ErrRecordNotFound) {
		return nil, nil
	}
	return result, err
}

