package testhelper

import (
	"sync"
	"testing"

	"github.com/KOMKZ/go-yogan-framework/testutil"
	"{{.ModuleName}}/internal/app"
	"github.com/gin-gonic/gin"
)

var (
	testServer *testutil.TestServer
	testApp    *app.{{.AppNamePascal}}
	initOnce   sync.Once
	// initErr holds the boot error so failures surface on EVERY GetServer
	// call instead of being swallowed inside sync.Once.
	initErr error
)

// GetServer returns the shared test server of {{.AppName}}.
func GetServer(t *testing.T) *testutil.TestServer {
	t.Helper()

	// Restore the previous env value after this test automatically.
	t.Setenv("APP_ENV", "test")

	initOnce.Do(func() {
		gin.SetMode(gin.TestMode)

		testApp = app.NewWithConfig("../../config")

		var err error
		testServer, err = testutil.NewTestServer(testApp)
		if err != nil {
			initErr = err
			return
		}
	})

	if initErr != nil {
		t.Fatalf("failed to create test server: %v", initErr)
	}
	return testServer
}

// Shutdown stops the shared test server.
func Shutdown() {
	if testApp != nil {
		testApp.Shutdown()
	}
}
