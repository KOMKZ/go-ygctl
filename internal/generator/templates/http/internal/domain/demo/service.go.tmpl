package demo

import (
	"context"
	"errors"
	"fmt"

	"{{.ModuleName}}/internal/domain/demo/model"
	"github.com/KOMKZ/go-yogan-framework/database"
	"github.com/KOMKZ/go-yogan-framework/logger"
	"go.uber.org/zap"
)

// Service handles demo business logic
type Service struct {
	repo   Repository
	logger *logger.CtxZapLogger
}

// NewService creates demo service
func NewService(repo Repository, log *logger.CtxZapLogger) *Service {
	return &Service{
		repo:   repo,
		logger: log,
	}
}

// CreateInput input for creating demo
type CreateInput struct {
	Title   string
	Content string
	Status  int8
}

// UpdateInput input for updating demo
type UpdateInput struct {
	Title   *string
	Content *string
	Status  *int8
}

// PageResult pagination result
type PageResult struct {
	Records []model.Demo `json:"records"`
	Total   int64        `json:"total"`
	Size    int          `json:"size"`
	Current int          `json:"current"`
	Pages   int          `json:"pages"`
}

// Create creates a new demo
func (s *Service) Create(ctx context.Context, input CreateInput) (*model.Demo, error) {
	s.logger.DebugCtx(ctx, "Creating demo", zap.String("title", input.Title))

	existing, err := s.repo.FindByTitle(ctx, input.Title)
	if err != nil && !errors.Is(err, database.ErrRecordNotFound) {
		s.logger.ErrorCtx(ctx, "Failed to check title", zap.Error(err))
		return nil, fmt.Errorf("database error: %w", err)
	}
	if existing != nil {
		return nil, fmt.Errorf("title already exists")
	}

	demo := &model.Demo{
		Title:   input.Title,
		Content: input.Content,
		Status:  input.Status,
	}

	if err := s.repo.Create(ctx, demo); err != nil {
		s.logger.ErrorCtx(ctx, "Failed to create demo", zap.Error(err))
		return nil, fmt.Errorf("failed to create: %w", err)
	}

	s.logger.InfoCtx(ctx, "Demo created", zap.Uint("id", demo.ID))
	return demo, nil
}

// GetByID gets demo by ID
func (s *Service) GetByID(ctx context.Context, id uint) (*model.Demo, error) {
	demo, err := s.repo.FindByID(ctx, id)
	if err != nil {
		if errors.Is(err, database.ErrRecordNotFound) {
			return nil, fmt.Errorf("demo not found")
		}
		return nil, fmt.Errorf("database error: %w", err)
	}
	return demo, nil
}

// Update updates demo
func (s *Service) Update(ctx context.Context, id uint, input UpdateInput) (*model.Demo, error) {
	demo, err := s.repo.FindByID(ctx, id)
	if err != nil {
		if errors.Is(err, database.ErrRecordNotFound) {
			return nil, fmt.Errorf("demo not found")
		}
		return nil, fmt.Errorf("database error: %w", err)
	}

	if input.Title != nil {
		demo.Title = *input.Title
	}
	if input.Content != nil {
		demo.Content = *input.Content
	}
	if input.Status != nil {
		demo.Status = *input.Status
	}

	if err := s.repo.Update(ctx, demo); err != nil {
		s.logger.ErrorCtx(ctx, "Failed to update demo", zap.Error(err))
		return nil, fmt.Errorf("failed to update: %w", err)
	}

	s.logger.InfoCtx(ctx, "Demo updated", zap.Uint("id", id))
	return demo, nil
}

// Delete deletes demo
func (s *Service) Delete(ctx context.Context, id uint) error {
	if err := s.repo.Delete(ctx, id); err != nil {
		if errors.Is(err, database.ErrRecordNotFound) {
			return fmt.Errorf("demo not found")
		}
		return fmt.Errorf("failed to delete: %w", err)
	}

	s.logger.InfoCtx(ctx, "Demo deleted", zap.Uint("id", id))
	return nil
}

// ListPage returns paginated demos
func (s *Service) ListPage(ctx context.Context, page, pageSize int, filters map[string]interface{}) (*PageResult, error) {
	records, total, err := s.repo.Paginate(ctx, page, pageSize, filters)
	if err != nil {
		return nil, fmt.Errorf("database error: %w", err)
	}

	pages := int(total) / pageSize
	if int(total)%pageSize > 0 {
		pages++
	}

	return &PageResult{
		Records: records,
		Total:   total,
		Size:    pageSize,
		Current: page,
		Pages:   pages,
	}, nil
}
