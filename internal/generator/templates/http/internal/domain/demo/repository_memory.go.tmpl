package demo

import (
	"context"
	"errors"
	"sort"
	"strings"
	"sync"
	"time"

	"{{.ModuleName}}/internal/domain/demo/model"
	"github.com/KOMKZ/go-yogan-framework/database"
)

// MemoryRepository in-memory implementation of Repository for demo purposes
type MemoryRepository struct {
	mu      sync.RWMutex
	data    map[uint]*model.Demo
	counter uint
}

// NewMemoryRepository creates a new in-memory repository
func NewMemoryRepository() *MemoryRepository {
	repo := &MemoryRepository{
		data:    make(map[uint]*model.Demo),
		counter: 0,
	}
	repo.seed()
	return repo
}

// seed adds initial demo data
func (r *MemoryRepository) seed() {
	now := time.Now()
	demos := []model.Demo{
		{ID: 1, Title: "Hello World", Content: "This is the first demo", Status: 1, CreatedAt: now, UpdatedAt: now},
		{ID: 2, Title: "Getting Started", Content: "Learn how to use this framework", Status: 1, CreatedAt: now, UpdatedAt: now},
		{ID: 3, Title: "Advanced Topics", Content: "Deep dive into advanced features", Status: 0, CreatedAt: now, UpdatedAt: now},
	}
	for i := range demos {
		r.data[demos[i].ID] = &demos[i]
	}
	r.counter = 3
}

// Create creates a new demo
func (r *MemoryRepository) Create(ctx context.Context, demo *model.Demo) error {
	r.mu.Lock()
	defer r.mu.Unlock()

	r.counter++
	demo.ID = r.counter
	demo.CreatedAt = time.Now()
	demo.UpdatedAt = time.Now()

	stored := *demo
	r.data[demo.ID] = &stored
	return nil
}

// FindByID finds demo by ID
func (r *MemoryRepository) FindByID(ctx context.Context, id uint) (*model.Demo, error) {
	r.mu.RLock()
	defer r.mu.RUnlock()

	demo, ok := r.data[id]
	if !ok {
		return nil, database.ErrRecordNotFound
	}
	result := *demo
	return &result, nil
}

// Update updates demo
func (r *MemoryRepository) Update(ctx context.Context, demo *model.Demo) error {
	r.mu.Lock()
	defer r.mu.Unlock()

	if _, ok := r.data[demo.ID]; !ok {
		return database.ErrRecordNotFound
	}

	demo.UpdatedAt = time.Now()
	stored := *demo
	r.data[demo.ID] = &stored
	return nil
}

// Delete deletes demo by ID
func (r *MemoryRepository) Delete(ctx context.Context, id uint) error {
	r.mu.Lock()
	defer r.mu.Unlock()

	if _, ok := r.data[id]; !ok {
		return database.ErrRecordNotFound
	}
	delete(r.data, id)
	return nil
}

// Paginate returns paginated demos
func (r *MemoryRepository) Paginate(ctx context.Context, page, pageSize int, filters map[string]interface{}) ([]model.Demo, int64, error) {
	r.mu.RLock()
	defer r.mu.RUnlock()

	var filtered []model.Demo
	for _, demo := range r.data {
		if title, ok := filters["title"].(string); ok && title != "" {
			if !strings.Contains(strings.ToLower(demo.Title), strings.ToLower(title)) {
				continue
			}
		}
		if status, ok := filters["status"].(int8); ok {
			if demo.Status != status {
				continue
			}
		}
		filtered = append(filtered, *demo)
	}

	sort.Slice(filtered, func(i, j int) bool {
		return filtered[i].ID > filtered[j].ID
	})

	total := int64(len(filtered))

	offset := (page - 1) * pageSize
	if offset >= len(filtered) {
		return []model.Demo{}, total, nil
	}

	end := offset + pageSize
	if end > len(filtered) {
		end = len(filtered)
	}

	return filtered[offset:end], total, nil
}

// FindByTitle finds demo by title
func (r *MemoryRepository) FindByTitle(ctx context.Context, title string) (*model.Demo, error) {
	r.mu.RLock()
	defer r.mu.RUnlock()

	for _, demo := range r.data {
		if demo.Title == title {
			result := *demo
			return &result, nil
		}
	}
	return nil, database.ErrRecordNotFound
}

var _ Repository = (*MemoryRepository)(nil)

var ErrNotFound = errors.New("record not found")
