package app

import (
	"testing"
	"time"

	"github.com/KOMKZ/go-yogan-framework/application"
)

func TestNewDefaultConstruction(t *testing.T) {
	// Lazy construction only: config loading tolerates a missing default
	// config directory at this stage; no chdir tricks required.
	a := New()
	if a == nil || a.Core == nil {
		t.Fatal("New() returned nil application")
	}
}

func TestAppLifecycle(t *testing.T) {
	t.Setenv("APP_ENV", "test")

	// NewWithConfig + full non-blocking boot
	app := NewWithConfig("../../config")
	if err := app.WithVersion("test").RunNonBlocking(); err != nil {
		t.Fatalf("boot failed: %v", err)
	}
	if app.GetHTTPServer() == nil {
		t.Fatal("HTTP server should not be nil")
	}
	_ = app.GetDBManager()
	_ = app.GetRedisManager()
	app.Shutdown()

	// NewWithFlags construction path
	flags := &application.AppFlags{ConfigDir: "../../config"}
	app3 := NewWithFlags(flags)
	if app3 == nil {
		t.Fatal("NewWithFlags() returned nil application")
	}

	// Blocking Run(): boot in background, wait until running, then shutdown.
	// Covers the graceful shutdown path (requires framework managers to be
	// nil-safe; see go-yogan-framework docs/framework-patterns/kernel-shutdown.md).
	app4 := NewWithConfig("../../config")
	done := make(chan error, 1)
	go func() { done <- app4.Run() }()

	deadline := time.Now().Add(5 * time.Second)
	for app4.Core.GetState() != application.StateRunning {
		if time.Now().After(deadline) {
			t.Fatal("application did not reach running state")
		}
		time.Sleep(10 * time.Millisecond)
	}

	app4.Shutdown()
	select {
	case err := <-done:
		if err != nil {
			t.Fatalf("Run failed: %v", err)
		}
	case <-time.After(5 * time.Second):
		t.Fatal("Run did not return after Shutdown")
	}
}
