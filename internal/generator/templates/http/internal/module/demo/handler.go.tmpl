package demo

import (
	"strconv"

	demoDomain "{{.ModuleName}}/internal/domain/demo"
	"{{.ModuleName}}/internal/domain/demo/model"
	"github.com/KOMKZ/go-yogan-framework/httpx"
	"github.com/KOMKZ/go-yogan-framework/logger"
	"github.com/gin-gonic/gin"
)

// Handler handles demo HTTP requests
type Handler struct {
	service *demoDomain.Service
	logger  *logger.CtxZapLogger
}

// NewHandler creates demo handler
func NewHandler(service *demoDomain.Service, log *logger.CtxZapLogger) *Handler {
	return &Handler{
		service: service,
		logger:  log,
	}
}

// ListPage handles GET /api/demos/page
func (h *Handler) ListPage(c *gin.Context) {
	var req PageRequest
	if err := c.ShouldBindQuery(&req); err != nil {
		httpx.BadRequestJson(c, err)
		return
	}

	filters := make(map[string]interface{})
	if req.Title != "" {
		filters["title"] = req.Title
	}
	if req.Status != nil {
		filters["status"] = *req.Status
	}

	result, err := h.service.ListPage(c.Request.Context(), req.Current, req.Size, filters)
	if err != nil {
		httpx.HandleError(c, err)
		return
	}

	response := PageResponse{
		Records: make([]DemoResponse, len(result.Records)),
		Total:   result.Total,
		Size:    result.Size,
		Current: result.Current,
		Pages:   result.Pages,
	}
	for i, record := range result.Records {
		response.Records[i] = toResponse(&record)
	}

	httpx.OkJson(c, response)
}

// GetByID handles GET /api/demos/:id
func (h *Handler) GetByID(c *gin.Context) {
	id, err := strconv.ParseUint(c.Param("id"), 10, 32)
	if err != nil {
		httpx.BadRequestJson(c, err)
		return
	}

	demo, err := h.service.GetByID(c.Request.Context(), uint(id))
	if err != nil {
		httpx.HandleError(c, err)
		return
	}

	httpx.OkJson(c, toResponse(demo))
}

// Create handles POST /api/demos
func (h *Handler) Create(c *gin.Context) {
	var req CreateRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		httpx.BadRequestJson(c, err)
		return
	}

	input := demoDomain.CreateInput{
		Title:   req.Title,
		Content: req.Content,
		Status:  req.Status,
	}

	demo, err := h.service.Create(c.Request.Context(), input)
	if err != nil {
		httpx.HandleError(c, err)
		return
	}

	httpx.OkJson(c, toResponse(demo))
}

// Update handles PUT /api/demos/:id
func (h *Handler) Update(c *gin.Context) {
	id, err := strconv.ParseUint(c.Param("id"), 10, 32)
	if err != nil {
		httpx.BadRequestJson(c, err)
		return
	}

	var req UpdateRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		httpx.BadRequestJson(c, err)
		return
	}

	input := demoDomain.UpdateInput{
		Title:   req.Title,
		Content: req.Content,
		Status:  req.Status,
	}

	demo, err := h.service.Update(c.Request.Context(), uint(id), input)
	if err != nil {
		httpx.HandleError(c, err)
		return
	}

	httpx.OkJson(c, toResponse(demo))
}

// Delete handles DELETE /api/demos/:id
func (h *Handler) Delete(c *gin.Context) {
	id, err := strconv.ParseUint(c.Param("id"), 10, 32)
	if err != nil {
		httpx.BadRequestJson(c, err)
		return
	}

	if err := h.service.Delete(c.Request.Context(), uint(id)); err != nil {
		httpx.HandleError(c, err)
		return
	}

	httpx.OkJson(c, gin.H{"message": "deleted"})
}

func toResponse(demo *model.Demo) DemoResponse {
	return DemoResponse{
		ID:        demo.ID,
		Title:     demo.Title,
		Content:   demo.Content,
		Status:    demo.Status,
		CreatedAt: demo.CreatedAt,
		UpdatedAt: demo.UpdatedAt,
	}
}
