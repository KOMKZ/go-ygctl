#!/bin/bash
# {{.AppName}} Build Script
# 编译 {{.AppName}} 应用

set -e

# 颜色定义
GREEN='\033[0;32m'
BLUE='\033[0;34m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

# 目录设置
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
BUILD_DIR="${APP_DIR}/build"
APP_NAME="{{.AppName}}"
OUTPUT_FILE="${BUILD_DIR}/${APP_NAME}"

# 显示帮助
show_help() {
    echo -e "${BLUE}${APP_NAME} Build Script${NC}"
    echo ""
    echo "Usage: $0 [options]"
    echo ""
    echo "Options:"
    echo "  -h, --help     显示帮助信息"
    echo "  -c, --clean    编译前清理旧的二进制文件"
    echo "  -r, --run      编译后立即运行"
    echo ""
    echo "Output: ${OUTPUT_FILE}"
}

# 解析参数
CLEAN=false
RUN_AFTER=false

while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            show_help
            exit 0
            ;;
        -c|--clean)
            CLEAN=true
            shift
            ;;
        -r|--run)
            RUN_AFTER=true
            shift
            ;;
        *)
            echo -e "${RED}未知选项: $1${NC}"
            show_help
            exit 1
            ;;
    esac
done

echo -e "${BLUE}================================================${NC}"
echo -e "${BLUE}编译 ${APP_NAME}${NC}"
echo -e "${BLUE}================================================${NC}"

# 清理旧文件
if [ "$CLEAN" = true ] && [ -f "$OUTPUT_FILE" ]; then
    echo -e "${YELLOW}清理旧的二进制文件...${NC}"
    rm -f "$OUTPUT_FILE"
fi

# 创建 build 目录
mkdir -p "${BUILD_DIR}"

# 切换到应用目录
cd "${APP_DIR}"

# 获取版本信息
VERSION=$(git describe --tags --always --dirty 2>/dev/null || echo "dev")
BUILD_TIME=$(date -u '+%Y-%m-%d_%H:%M:%S_UTC')
GIT_COMMIT=$(git rev-parse --short HEAD 2>/dev/null || echo "unknown")

echo -e "${BLUE}版本: ${VERSION}${NC}"
echo -e "${BLUE}提交: ${GIT_COMMIT}${NC}"
echo -e "${BLUE}时间: ${BUILD_TIME}${NC}"
echo ""

# 编译
echo -e "${BLUE}正在编译...${NC}"
go build \
    -ldflags "-X main.Version=${VERSION} -X main.BuildTime=${BUILD_TIME} -X main.GitCommit=${GIT_COMMIT}" \
    -o "${OUTPUT_FILE}" \
    .

if [ $? -eq 0 ]; then
    SIZE=$(du -h "${OUTPUT_FILE}" | cut -f1)
    echo -e "${GREEN}✅ 编译成功${NC}"
    echo -e "   输出: ${OUTPUT_FILE}"
    echo -e "   大小: ${SIZE}"
else
    echo -e "${RED}❌ 编译失败${NC}"
    exit 1
fi

echo -e "${BLUE}================================================${NC}"

# 编译后运行
if [ "$RUN_AFTER" = true ]; then
    echo ""
    echo -e "${BLUE}启动 ${APP_NAME}...${NC}"
    exec "${OUTPUT_FILE}"
fi
