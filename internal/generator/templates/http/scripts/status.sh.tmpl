#!/bin/bash
# {{.AppName}} Status Script
# 查看 {{.AppName}} 应用状态

# 颜色定义
GREEN='\033[0;32m'
BLUE='\033[0;34m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

# 目录设置
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
BUILD_DIR="${APP_DIR}/build"
APP_NAME="{{.AppName}}"
BINARY="${BUILD_DIR}/${APP_NAME}"
LOGS_DIR="${APP_DIR}/logs"
PID_FILE="${APP_DIR}/${APP_NAME}.pid"
LOG_FILE="${LOGS_DIR}/${APP_NAME}.log"

echo -e "${BLUE}================================================${NC}"
echo -e "${BLUE}${APP_NAME} Status${NC}"
echo -e "${BLUE}================================================${NC}"
echo ""

# 检查二进制文件
echo -e "${BLUE}Binary:${NC}"
if [ -f "$BINARY" ]; then
    size=$(du -h "$BINARY" | cut -f1)
    mtime=$(stat -f "%Sm" "$BINARY" 2>/dev/null || stat -c "%y" "$BINARY" 2>/dev/null | cut -d'.' -f1)
    echo -e "  ${GREEN}✓${NC} $BINARY"
    echo -e "    大小: $size"
    echo -e "    修改: $mtime"
else
    echo -e "  ${RED}✗${NC} 未编译 ($BINARY)"
fi
echo ""

# 检查进程状态
echo -e "${BLUE}Process:${NC}"
if [ -f "$PID_FILE" ]; then
    pid=$(cat "$PID_FILE")
    if ps -p "$pid" > /dev/null 2>&1; then
        echo -e "  ${GREEN}● 运行中${NC} (PID: $pid)"
        
        # 显示进程详情
        ps -p "$pid" -o pid,ppid,%cpu,%mem,etime,command | tail -1 | while read line; do
            echo -e "    $line"
        done
        
        # 显示监听端口
        ports=$(lsof -i -P -n -p "$pid" 2>/dev/null | grep LISTEN | awk '{print $9}' | tr '\n' ' ')
        if [ -n "$ports" ]; then
            echo -e "    监听: $ports"
        fi
    else
        echo -e "  ${RED}● 已停止${NC} (PID 文件存在但进程不存在)"
        echo -e "    PID 文件: $PID_FILE"
    fi
else
    # 检查是否有未跟踪的进程
    pids=$(pgrep -f "${APP_NAME}$" 2>/dev/null || true)
    if [ -n "$pids" ]; then
        echo -e "  ${YELLOW}● 未跟踪${NC}"
        for pid in $pids; do
            echo -e "    发现进程: $pid"
        done
    else
        echo -e "  ${RED}○ 未运行${NC}"
    fi
fi
echo ""

# 检查日志文件
echo -e "${BLUE}Log:${NC}"
if [ -f "$LOG_FILE" ]; then
    size=$(du -h "$LOG_FILE" | cut -f1)
    lines=$(wc -l < "$LOG_FILE" | tr -d ' ')
    echo -e "  ${GREEN}✓${NC} $LOG_FILE"
    echo -e "    大小: $size, 行数: $lines"
    echo ""
    echo -e "${BLUE}最近日志 (最后 5 行):${NC}"
    tail -5 "$LOG_FILE" | sed 's/^/  /'
else
    echo -e "  ${YELLOW}-${NC} 日志文件不存在"
fi
echo ""

# 检查配置文件
echo -e "${BLUE}Config:${NC}"
config_file="${APP_DIR}/config/config.yaml"
if [ -f "$config_file" ]; then
    echo -e "  ${GREEN}✓${NC} $config_file"
else
    echo -e "  ${RED}✗${NC} 配置文件不存在: $config_file"
fi

echo ""
echo -e "${BLUE}================================================${NC}"
