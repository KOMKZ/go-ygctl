#!/bin/bash
# Database Migration Script for {{.AppName}}

set -e

# Get script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
MIGRATIONS_DIR="$APP_DIR/migrations"

# Database connection (override with environment variables)
DB_HOST="${DB_HOST:-localhost}"
DB_PORT="${DB_PORT:-3306}"
DB_USER="${DB_USER:-root}"
DB_PASS="${DB_PASS:-123456}"
DB_NAME="${DB_NAME:-{{.AppNameSnake}}}"

# Colors
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Check migrate tool
check_migrate() {
    if ! command -v migrate &> /dev/null; then
        echo -e "${RED}❌ Error: migrate tool not found${NC}"
        echo ""
        echo "Install with:"
        echo "  go install -tags 'mysql' github.com/golang-migrate/migrate/v4/cmd/migrate@latest"
        exit 1
    fi
}

# Show help
show_help() {
    echo -e "${BLUE}Database Migration Tool - {{.AppName}}${NC}"
    echo ""
    echo "Usage: $0 <command> [options]"
    echo ""
    echo "Commands:"
    echo "  up [N]         - Run migrations (optional: run N migrations)"
    echo "  down [N]       - Rollback migrations (optional: rollback N, default 1)"
    echo "  goto V         - Migrate to specific version"
    echo "  drop           - Drop all tables (DANGEROUS!)"
    echo "  version        - Show current version"
    echo "  create NAME    - Create new migration files"
    echo ""
    echo "Environment Variables:"
    echo "  DB_HOST        - Database host (default: localhost)"
    echo "  DB_PORT        - Database port (default: 3306)"
    echo "  DB_USER        - Database user (default: root)"
    echo "  DB_PASS        - Database password (default: 123456)"
    echo "  DB_NAME        - Database name (default: {{.AppNameSnake}})"
    echo ""
    echo "Examples:"
    echo "  $0 up                          # Run all pending migrations"
    echo "  $0 down                        # Rollback last migration"
    echo "  $0 down 2                      # Rollback last 2 migrations"
    echo "  $0 create add_orders_table     # Create new migration"
    echo "  DB_NAME=test_db $0 up          # Run on test database"
}

# Run migration command
run_migrate() {
    check_migrate
    
    # Build database URL
    DATABASE_URL="mysql://${DB_USER}:${DB_PASS}@tcp(${DB_HOST}:${DB_PORT})/${DB_NAME}?charset=utf8mb4&parseTime=true"
    
    echo -e "${GREEN}📂 Migrations: ${MIGRATIONS_DIR}${NC}"
    echo -e "${GREEN}🔗 Database: mysql://${DB_USER}:****@tcp(${DB_HOST}:${DB_PORT})/${DB_NAME}${NC}"
    echo ""
    
    migrate -path "$MIGRATIONS_DIR" -database "$DATABASE_URL" "$@"
    
    if [ $? -eq 0 ]; then
        echo -e "${GREEN}✅ Migration completed successfully${NC}"
    else
        echo -e "${RED}❌ Migration failed${NC}"
        exit 1
    fi
}

# Parse arguments
if [ $# -eq 0 ]; then
    show_help
    exit 1
fi

# Handle help
if [ "$1" = "help" ] || [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    show_help
    exit 0
fi

# Execute command
case "$1" in
    up)
        if [ -n "$2" ]; then
            run_migrate up "$2"
        else
            run_migrate up
        fi
        ;;
    down)
        if [ -n "$2" ]; then
            run_migrate down "$2"
        else
            run_migrate down 1
        fi
        ;;
    goto)
        if [ -z "$2" ]; then
            echo -e "${RED}❌ Error: Version number required${NC}"
            echo "Usage: $0 goto <version>"
            exit 1
        fi
        run_migrate goto "$2"
        ;;
    drop)
        echo -e "${RED}⚠️  Warning: This will DROP all tables in ${DB_NAME}!${NC}"
        read -p "Are you sure? (yes/no): " confirm
        if [ "$confirm" = "yes" ]; then
            run_migrate drop -f
        else
            echo "Aborted."
        fi
        ;;
    version)
        run_migrate version
        ;;
    create)
        if [ -z "$2" ]; then
            echo -e "${RED}❌ Error: Migration name required${NC}"
            echo "Usage: $0 create <name>"
            exit 1
        fi
        check_migrate
        mkdir -p "$MIGRATIONS_DIR"
        migrate create -ext sql -dir "$MIGRATIONS_DIR" -seq "$2"
        echo -e "${GREEN}✅ Migration files created in ${MIGRATIONS_DIR}${NC}"
        ;;
    *)
        echo -e "${RED}❌ Error: Unknown command '$1'${NC}"
        echo ""
        show_help
        exit 1
        ;;
esac
