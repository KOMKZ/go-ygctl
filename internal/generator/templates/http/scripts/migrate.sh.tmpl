#!/bin/bash
# {{.AppName}} Database Migration Script
# 专用于 {{.AppName}} 应用的数据库迁移脚本

set -e

# 颜色定义
GREEN='\033[0;32m'
BLUE='\033[0;34m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

# 目录设置
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
MIGRATIONS_DIR="${APP_DIR}/migrations"
APP_NAME="{{.AppName}}"

# 数据库配置（可通过环境变量覆盖）
DB_HOST="${DB_HOST:-localhost}"
DB_PORT="${DB_PORT:-3306}"
DB_USER="${DB_USER:-root}"
# 无默认密码：必须显式传 DB_PASS（本地开发空密码可传 DB_PASS=""）
DB_PASS="${DB_PASS:-}"
DB_NAME="${DB_NAME:-{{.AppNameSnake}}}"

# 显示帮助
show_help() {
    echo -e "${BLUE}${APP_NAME} Database Migration Tool${NC}"
    echo ""
    echo "Usage: $0 <command> [options]"
    echo ""
    echo "Commands:"
    echo "  up [N]         运行迁移（可选：运行 N 个迁移）"
    echo "  down [N]       回滚迁移（可选：回滚 N 个，默认 1）"
    echo "  goto V         迁移到指定版本"
    echo "  force V        强制设置版本（用于脏数据库状态）"
    echo "  drop           删除所有表（危险！）"
    echo "  version        显示当前版本"
    echo "  create NAME    创建新的迁移文件"
    echo "  list           列出所有迁移文件"
    echo ""
    echo "Environment Variables:"
    echo "  DB_HOST        数据库主机 (default: localhost)"
    echo "  DB_PORT        数据库端口 (default: 3306)"
    echo "  DB_USER        数据库用户 (default: root)"
    echo "  DB_PASS        数据库密码（无默认值，必须显式传入；本地开发可用空密码）"
    echo "  DB_NAME        数据库名称 (default: {{.AppNameSnake}})"
    echo ""
    echo "Examples:"
    echo "  $0 up                    # 运行所有待执行的迁移"
    echo "  $0 down                  # 回滚最后一个迁移"
    echo "  $0 down 2                # 回滚最后 2 个迁移"
    echo "  $0 create add_orders     # 创建新迁移文件"
    echo "  $0 version               # 查看当前版本"
    echo "  DB_NAME=test_db $0 up    # 在测试数据库上运行"
}

# 检查 migrate 工具
check_migrate() {
    if ! command -v migrate &> /dev/null; then
        echo -e "${RED}❌ migrate 工具未找到${NC}"
        echo ""
        echo "安装方法:"
        echo "  # macOS"
        echo "  brew install golang-migrate"
        echo ""
        echo "  # 或使用 go install"
        echo "  go install -tags 'mysql' github.com/golang-migrate/migrate/v4/cmd/migrate@latest"
        exit 1
    fi
}

# 构建数据库 URL
get_database_url() {
    echo "mysql://${DB_USER}:${DB_PASS}@tcp(${DB_HOST}:${DB_PORT})/${DB_NAME}?charset=utf8mb4&parseTime=true"
}

# 显示连接信息
show_connection_info() {
    echo -e "${GREEN}📂 Migrations: ${MIGRATIONS_DIR}${NC}"
    echo -e "${GREEN}🔗 Database: mysql://${DB_USER}:****@tcp(${DB_HOST}:${DB_PORT})/${DB_NAME}${NC}"
    echo ""
}

# 运行迁移命令
run_migrate() {
    check_migrate
    show_connection_info
    
    local database_url=$(get_database_url)
    migrate -path "$MIGRATIONS_DIR" -database "$database_url" "$@"
    
    if [ $? -eq 0 ]; then
        echo -e "${GREEN}✅ 操作完成${NC}"
    else
        echo -e "${RED}❌ 操作失败${NC}"
        exit 1
    fi
}

# 列出迁移文件
list_migrations() {
    echo -e "${BLUE}${APP_NAME} Migrations:${NC}"
    echo ""
    
    if [ ! -d "$MIGRATIONS_DIR" ]; then
        echo -e "${YELLOW}迁移目录不存在: ${MIGRATIONS_DIR}${NC}"
        exit 1
    fi
    
    local count=0
    for f in "$MIGRATIONS_DIR"/*.up.sql; do
        if [ -f "$f" ]; then
            name=$(basename "$f" .up.sql)
            echo -e "  ${GREEN}$name${NC}"
            count=$((count + 1))
        fi
    done
    
    echo ""
    echo -e "共 ${count} 个迁移文件"
}

# 主逻辑
if [ $# -eq 0 ]; then
    show_help
    exit 1
fi

case "$1" in
    -h|--help|help)
        show_help
        ;;
    up)
        if [ -n "$2" ]; then
            run_migrate up "$2"
        else
            run_migrate up
        fi
        ;;
    down)
        if [ -n "$2" ]; then
            run_migrate down "$2"
        else
            run_migrate down 1
        fi
        ;;
    goto)
        if [ -z "$2" ]; then
            echo -e "${RED}❌ 需要指定版本号${NC}"
            echo "Usage: $0 goto <version>"
            exit 1
        fi
        run_migrate goto "$2"
        ;;
    force)
        if [ -z "$2" ]; then
            echo -e "${RED}❌ 需要指定版本号${NC}"
            echo "Usage: $0 force <version>"
            exit 1
        fi
        run_migrate force "$2"
        ;;
    drop)
        echo -e "${RED}⚠️  警告: 这将删除 ${DB_NAME} 中的所有表！${NC}"
        read -p "确定要继续吗？(yes/no): " confirm
        if [ "$confirm" = "yes" ]; then
            run_migrate drop -f
        else
            echo "已取消"
        fi
        ;;
    version)
        run_migrate version
        ;;
    create)
        if [ -z "$2" ]; then
            echo -e "${RED}❌ 需要指定迁移名称${NC}"
            echo "Usage: $0 create <name>"
            exit 1
        fi
        check_migrate
        mkdir -p "$MIGRATIONS_DIR"
        migrate create -ext sql -dir "$MIGRATIONS_DIR" -seq "$2"
        echo -e "${GREEN}✅ 迁移文件已创建${NC}"
        ls -la "$MIGRATIONS_DIR" | tail -2
        ;;
    list)
        list_migrations
        ;;
    *)
        echo -e "${RED}❌ 未知命令: $1${NC}"
        echo ""
        show_help
        exit 1
        ;;
esac
