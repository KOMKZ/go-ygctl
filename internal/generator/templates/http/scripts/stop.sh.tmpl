#!/bin/bash
# {{.AppName}} Stop Script
# 停止 {{.AppName}} 应用

# 颜色定义
GREEN='\033[0;32m'
BLUE='\033[0;34m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

# 目录设置
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
APP_NAME="{{.AppName}}"
PID_FILE="${APP_DIR}/${APP_NAME}.pid"

# 显示帮助
show_help() {
    echo -e "${BLUE}${APP_NAME} Stop Script${NC}"
    echo ""
    echo "Usage: $0 [options]"
    echo ""
    echo "Options:"
    echo "  -h, --help     显示帮助信息"
    echo "  -f, --force    强制停止 (SIGKILL)"
    echo "  -a, --all      停止所有 ${APP_NAME} 进程"
}

# 解析参数
FORCE=false
STOP_ALL=false

while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            show_help
            exit 0
            ;;
        -f|--force)
            FORCE=true
            shift
            ;;
        -a|--all)
            STOP_ALL=true
            shift
            ;;
        *)
            echo -e "${RED}未知选项: $1${NC}"
            show_help
            exit 1
            ;;
    esac
done

# 停止所有进程
if [ "$STOP_ALL" = true ]; then
    echo -e "${BLUE}查找所有 ${APP_NAME} 进程...${NC}"
    pids=$(pgrep -f "${APP_NAME}$" 2>/dev/null || true)
    
    if [ -z "$pids" ]; then
        echo -e "${YELLOW}没有找到运行中的 ${APP_NAME} 进程${NC}"
    else
        echo -e "${YELLOW}找到进程: $pids${NC}"
        for pid in $pids; do
            echo -e "停止进程 $pid..."
            if [ "$FORCE" = true ]; then
                kill -9 "$pid" 2>/dev/null || true
            else
                kill "$pid" 2>/dev/null || true
            fi
        done
        echo -e "${GREEN}✅ 已发送停止信号${NC}"
    fi
    
    rm -f "$PID_FILE"
    exit 0
fi

# 通过 PID 文件停止
if [ ! -f "$PID_FILE" ]; then
    echo -e "${YELLOW}⚠️  PID 文件不存在: ${PID_FILE}${NC}"
    
    # 尝试查找进程
    pids=$(pgrep -f "${APP_NAME}$" 2>/dev/null || true)
    if [ -n "$pids" ]; then
        echo -e "找到运行中的进程: $pids"
        echo "使用 -a/--all 停止所有进程"
    else
        echo "没有找到运行中的 ${APP_NAME} 进程"
    fi
    exit 1
fi

pid=$(cat "$PID_FILE")

if ! ps -p "$pid" > /dev/null 2>&1; then
    echo -e "${YELLOW}⚠️  进程 $pid 已不存在${NC}"
    rm -f "$PID_FILE"
    exit 0
fi

echo -e "${BLUE}停止 ${APP_NAME} (PID: $pid)...${NC}"

if [ "$FORCE" = true ]; then
    kill -9 "$pid" 2>/dev/null
    echo -e "${GREEN}✅ 已强制停止${NC}"
else
    kill "$pid" 2>/dev/null
    
    # 等待进程结束
    for i in {1..10}; do
        if ! ps -p "$pid" > /dev/null 2>&1; then
            break
        fi
        sleep 0.5
    done
    
    if ps -p "$pid" > /dev/null 2>&1; then
        echo -e "${YELLOW}进程未响应，强制停止...${NC}"
        kill -9 "$pid" 2>/dev/null || true
    fi
    
    echo -e "${GREEN}✅ ${APP_NAME} 已停止${NC}"
fi

rm -f "$PID_FILE"
