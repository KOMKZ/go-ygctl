#!/bin/bash
# {{.AppName}} Start Script
# 启动 {{.AppName}} 应用（支持后台运行）

set -e

# 颜色定义
GREEN='\033[0;32m'
BLUE='\033[0;34m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

# 目录设置
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
BUILD_DIR="${APP_DIR}/build"
APP_NAME="{{.AppName}}"
BINARY="${BUILD_DIR}/${APP_NAME}"
LOGS_DIR="${APP_DIR}/logs"
PID_FILE="${APP_DIR}/${APP_NAME}.pid"
LOG_FILE="${LOGS_DIR}/${APP_NAME}.log"

# 显示帮助
show_help() {
    echo -e "${BLUE}${APP_NAME} Start Script${NC}"
    echo ""
    echo "Usage: $0 [options]"
    echo ""
    echo "Options:"
    echo "  -h, --help        显示帮助信息"
    echo "  -d, --daemon      后台运行（守护进程模式）"
    echo "  -b, --build       启动前先编译"
    echo "  -f, --force       强制启动（如已运行则先停止）"
    echo ""
    echo "Files:"
    echo "  Binary:   ${BINARY}"
    echo "  PID:      ${PID_FILE}"
    echo "  Log:      ${LOG_FILE}"
}

# 检查进程是否运行
is_running() {
    if [ -f "$PID_FILE" ]; then
        local pid=$(cat "$PID_FILE")
        if ps -p "$pid" > /dev/null 2>&1; then
            return 0
        fi
    fi
    return 1
}

# 停止进程
stop_process() {
    if [ -f "$PID_FILE" ]; then
        local pid=$(cat "$PID_FILE")
        if ps -p "$pid" > /dev/null 2>&1; then
            echo -e "${YELLOW}停止现有进程 (PID: $pid)...${NC}"
            kill "$pid" 2>/dev/null || true
            sleep 2
            if ps -p "$pid" > /dev/null 2>&1; then
                kill -9 "$pid" 2>/dev/null || true
            fi
        fi
        rm -f "$PID_FILE"
    fi
}

# 解析参数
DAEMON=false
BUILD_FIRST=false
FORCE=false

while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            show_help
            exit 0
            ;;
        -d|--daemon)
            DAEMON=true
            shift
            ;;
        -b|--build)
            BUILD_FIRST=true
            shift
            ;;
        -f|--force)
            FORCE=true
            shift
            ;;
        *)
            echo -e "${RED}未知选项: $1${NC}"
            show_help
            exit 1
            ;;
    esac
done

# 检查是否已在运行
if is_running; then
    if [ "$FORCE" = true ]; then
        stop_process
    else
        pid=$(cat "$PID_FILE")
        echo -e "${YELLOW}⚠️  ${APP_NAME} 已在运行 (PID: $pid)${NC}"
        echo "使用 -f/--force 强制重启，或使用 stop.sh 停止"
        exit 1
    fi
fi

# 编译（如需要）
if [ "$BUILD_FIRST" = true ] || [ ! -f "$BINARY" ]; then
    echo -e "${BLUE}编译 ${APP_NAME}...${NC}"
    "$SCRIPT_DIR/build.sh"
fi

# 检查二进制文件
if [ ! -f "$BINARY" ]; then
    echo -e "${RED}❌ 二进制文件不存在: ${BINARY}${NC}"
    echo "请先运行: $SCRIPT_DIR/build.sh"
    exit 1
fi

# 切换到应用目录（配置文件相对路径）
cd "${APP_DIR}"

if [ "$DAEMON" = true ]; then
    # 后台运行
    mkdir -p "$LOGS_DIR"
    echo -e "${BLUE}后台启动 ${APP_NAME}...${NC}"
    nohup "$BINARY" >> "$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"
    sleep 1
    
    if is_running; then
        pid=$(cat "$PID_FILE")
        echo -e "${GREEN}✅ ${APP_NAME} 已启动${NC}"
        echo -e "   PID: $pid"
        echo -e "   日志: tail -f $LOG_FILE"
    else
        echo -e "${RED}❌ 启动失败，查看日志: $LOG_FILE${NC}"
        rm -f "$PID_FILE"
        exit 1
    fi
else
    # 前台运行
    echo -e "${BLUE}前台启动 ${APP_NAME}...${NC}"
    echo -e "${YELLOW}按 Ctrl+C 停止${NC}"
    echo ""
    exec "$BINARY"
fi
