# {{.AppName}} configuration

api_server:
  host: "0.0.0.0"
  port: {{.ServerPort}}
  mode: "debug"
  read_timeout: 60
  write_timeout: 60

logger:
  base_log_dir: "logs"
  app_name: "{{.AppName}}"
  logger_name: "{{.AppNameSnake}}"
  log_dir_mode: "single"
  level: "info"
  encoding: "json"
  enable_console: true
