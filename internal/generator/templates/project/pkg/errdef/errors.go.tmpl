// Package errdef declares shared errors consumed by the workspace apps.
//
// Contract (hrw-go-backend-good-style/errcode-and-errors):
//   - every error must be registered via errcode.Register
//   - business codes start from 1001; final code = module*10000 + business
//   - only declare errors here when MORE THAN ONE app consumes them;
//     app-local errors belong to the app or its domain
package errdef

import (
	"net/http"

	"github.com/KOMKZ/go-yogan-framework/errcode"
)

// Module codes: business codes start from 1001 per module.
const (
	ModuleCommon = 0  // shared/common errors 0xxxx
	ModuleUser   = 10 // user module 10xxxx
	ModuleAuth   = 20 // auth module 20xxxx
	ModuleOrder  = 30 // order module 30xxxx
)

// Common errors (module 0 => codes 1001+).
var (
	ErrInvalidInput = errcode.Register(errcode.New(
		ModuleCommon, 1001,
		"common",
		"error.common.invalid_input",
		"无效的输入参数",
		http.StatusBadRequest,
	))

	ErrNotFound = errcode.Register(errcode.New(
		ModuleCommon, 1002,
		"common",
		"error.common.not_found",
		"资源不存在",
		http.StatusNotFound,
	))

	ErrDatabaseError = errcode.Register(errcode.New(
		ModuleCommon, 1003,
		"common",
		"error.common.database_error",
		"数据库操作失败",
		http.StatusInternalServerError,
	))
)
