#!/bin/bash

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'

# Project root
PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BUILD_DIR="${PROJECT_ROOT}/build"

# Create build directory
mkdir -p "${BUILD_DIR}"

# Build function
build_app() {
    local app_name="$1"
    local app_path="${PROJECT_ROOT}/apps/${app_name}"
    
    if [ ! -d "${app_path}" ]; then
        echo -e "${RED}✗ App not found: ${app_name}${NC}"
        return 1
    fi
    
    echo -e "${BLUE}Building ${app_name}...${NC}"
    cd "${app_path}"
    go build -o "${BUILD_DIR}/${app_name}" .
    echo -e "${GREEN}✓ Built: ${app_name}${NC}"
}

# Main
if [ -n "$1" ]; then
    # Build specific app
    build_app "$1"
else
    # Build all apps
    echo -e "${BLUE}Building all applications...${NC}"
    for app_dir in "${PROJECT_ROOT}/apps"/*/; do
        if [ -f "${app_dir}/main.go" ]; then
            app_name=$(basename "${app_dir}")
            build_app "${app_name}"
        fi
    done
fi

echo ""
echo -e "${GREEN}Build complete!${NC}"
echo "Binaries are in: ${BUILD_DIR}"
