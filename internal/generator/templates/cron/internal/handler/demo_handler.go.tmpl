package handler

import (
	"fmt"
	"time"

	"github.com/KOMKZ/go-yogan-framework/logger"
	"go.uber.org/zap"
)

// DemoHandler demo task handler
type DemoHandler struct{}

// NewDemoHandler creates demo task handler
func NewDemoHandler() *DemoHandler {
	return &DemoHandler{}
}

// Demo demo task: prints hello world every minute
func (h *DemoHandler) Demo() {
	now := time.Now()
	msg := fmt.Sprintf("🏠 Demo task executed at: %s", now.Format("2006-01-02 15:04:05"))

	logger.Debug("cron-task", msg,
		zap.String("task", "Demo"),
		zap.Time("execute_time", now),
	)

	// Simulate task execution
	time.Sleep(2 * time.Second)

	logger.Debug("cron-task", "Demo task completed",
		zap.Duration("duration", time.Since(now)),
	)
}
