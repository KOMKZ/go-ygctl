package command

import (
	"context"
	"fmt"

	"{{.ModuleName}}/internal/handler"
	"github.com/KOMKZ/go-yogan-framework/application"
	"github.com/go-co-op/gocron/v2"
	"github.com/spf13/cobra"
)

// RegisterStartCommand registers start command
func RegisterStartCommand(rootCmd *cobra.Command, cronApp *application.CronApplication) {
	startCmd := &cobra.Command{
		Use:   "start",
		Short: "Start cron scheduler",
		Long: `Start cron scheduler, run all registered tasks.

Example:
  {{.AppName}} start
  {{.AppName}} start --config-dir ./config`,
		RunE: func(cmd *cobra.Command, args []string) error {
			return startScheduler(cronApp)
		},
	}

	rootCmd.AddCommand(startCmd)
}

// startScheduler starts the scheduler
func startScheduler(cronApp *application.CronApplication) error {
	logger := cronApp.MustGetLogger()

	// Create demo handler
	demoHandler := handler.NewDemoHandler()

	// Register tasks in OnReady callback
	cronApp.OnReady(func(app *application.CronApplication) error {
		logger.DebugCtx(context.Background(), "Starting cron task registration...")

		// 1. Demo task: every minute
		_, err := app.RegisterTask(
			"*/1 * * * *",
			demoHandler.Demo,
			gocron.WithName("demo"),
			gocron.WithTags("demo"),
		)
		if err != nil {
			return fmt.Errorf("failed to register demo task: %w", err)
		}
		logger.DebugCtx(context.Background(), "✅ Registered task: demo (every minute)")

		logger.DebugCtx(context.Background(), "✅ All cron tasks registered")
		return nil
	})

	// Start application (blocking)
	return cronApp.Run()
}
