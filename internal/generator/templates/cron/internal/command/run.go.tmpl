package command

import (
	"context"
	"fmt"

	"{{.ModuleName}}/internal/handler"
	"github.com/KOMKZ/go-yogan-framework/application"
	"github.com/spf13/cobra"
)

// RegisterRunCommand registers run command (manual task execution)
func RegisterRunCommand(rootCmd *cobra.Command, cronApp *application.CronApplication) {
	var taskName string

	runCmd := &cobra.Command{
		Use:   "run",
		Short: "Run single task manually",
		Long: `Run a single task manually (for testing/debugging).

Example:
  {{.AppName}} run --task demo`,
		RunE: func(cmd *cobra.Command, args []string) error {
			return runSingleTask(cronApp, taskName)
		},
	}

	runCmd.Flags().StringVarP(&taskName, "task", "t", "", "Task name to run (required)")
	runCmd.MarkFlagRequired("task")

	rootCmd.AddCommand(runCmd)
}

// runSingleTask runs a single task
func runSingleTask(cronApp *application.CronApplication, taskName string) error {
	// Initialize application (non-blocking)
	if err := cronApp.RunNonBlocking(); err != nil {
		return fmt.Errorf("failed to initialize application: %w", err)
	}

	logger := cronApp.MustGetLogger()
	demoHandler := handler.NewDemoHandler()

	// Find and execute task
	switch taskName {
	case "demo":
		fmt.Println("🚀 Running task: demo")
		demoHandler.Demo()
		fmt.Println("✅ Task completed: demo")

	default:
		return fmt.Errorf("unknown task: %s", taskName)
	}

	logger.DebugCtx(context.Background(), "Task executed manually")
	return nil
}
