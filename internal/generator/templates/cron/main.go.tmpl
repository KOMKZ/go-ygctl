package main

import (
	"fmt"
	"os"

	"{{.ModuleName}}/internal/app"
	"github.com/KOMKZ/go-yogan-framework/application"
)

const Version = "0.1.0"

func main() {
	// Parse command line flags and environment variables
	flags := application.ParseFlags("{{.AppName}}", "./config")

	// Start Cron application
	if err := app.MustNewWithConfig(flags.ConfigDir).Run(); err != nil {
		fmt.Fprintf(os.Stderr, "❌ Error: %v\n", err)
		os.Exit(1)
	}
}
