# {{.AppName}} Cron application configuration

# Logger configuration
logger:
  base_log_dir: "./logs"
  logger_name: "logger"
  app_name: "{{.AppName}}"
  module_number: 20
  level: "debug"
  encoding: "json"
  console_encoding: "console_pretty"
  render_style: "single_line"
  enable_console: true
  enable_level_in_filename: true
  enable_date_in_filename: true
  date_format: "2006-01-02"
  max_size: 100
  max_backups: 3
  max_age: 28
  compress: true
  enable_caller: true
  enable_stacktrace: true
  stacktrace_level: "error"
  stacktrace_depth: 5
  enable_trace_id: true
  trace_id_key: "trace_id"
  trace_id_field_name: "trace_id"

# Cron configuration
cron:
  timezone: "Asia/Shanghai"
  shutdown_timeout: 30    # Graceful shutdown timeout (seconds)

