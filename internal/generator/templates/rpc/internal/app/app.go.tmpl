// Package app encapsulates the gRPC application logic
package app

import (
	"sync"

	"{{.ModuleName}}/internal/config"
	"github.com/KOMKZ/go-yogan-framework/application"
	"github.com/KOMKZ/go-yogan-framework/logger"
)

// {{.AppNamePascal}}App gRPC application instance
type {{.AppNamePascal}}App struct {
	Core       *application.GRPCApplication // gRPC application core
	cfg        *config.{{.AppNamePascal}}Config
	cfgMu      sync.RWMutex
	configPath string
	flags      *application.AppFlags
	logger     *logger.CtxZapLogger
	version    string
}

// NewWithFlags creates application instance with command line flags
func NewWithFlags(flags *application.AppFlags) *{{.AppNamePascal}}App {
	return &{{.AppNamePascal}}App{
		configPath: flags.ConfigDir,
		flags:      flags,
		Core:       application.NewGRPC(flags.ConfigDir, "{{.AppNameUpper}}", flags),
		logger:     logger.GetLogger("{{.AppNameSnake}}"),
	}
}

// WithVersion sets application version (chainable)
func (a *{{.AppNamePascal}}App) WithVersion(version string) *{{.AppNamePascal}}App {
	a.version = version
	return a
}

// Run starts the application (blocking)
func (a *{{.AppNamePascal}}App) Run() error {
	// Register components
	a.RegisterComponents(a.Core)

	// Setup callbacks
	a.SetupCallbacks()

	// Run application (blocking until shutdown signal)
	a.Core.Run()

	return nil
}

// SetupCallbacks registers all callbacks
func (a *{{.AppNamePascal}}App) SetupCallbacks() {
	a.Core.OnSetup(a.onSetup)
	a.Core.OnReady(a.onReady)
	a.Core.OnShutdown(a.onShutdown)
}

// GetConfig returns current config (thread-safe)
func (a *{{.AppNamePascal}}App) GetConfig() *config.{{.AppNamePascal}}Config {
	a.cfgMu.RLock()
	defer a.cfgMu.RUnlock()
	return a.cfg
}
