package app

import (
	"github.com/KOMKZ/go-yogan-framework/application"
	"github.com/KOMKZ/go-yogan-framework/di"
	frameworkgrpc "github.com/KOMKZ/go-yogan-framework/grpc"
	"github.com/KOMKZ/go-yogan-framework/logger"
	"github.com/samber/do/v2"
)

// {{.AppNamePascal}} is a gRPC application hosted by the {{.ProjectName}} workspace.
type {{.AppNamePascal}} struct {
	Core       *application.GRPCApplication
	configPath string
	logger     *logger.CtxZapLogger
}

// New creates an application with the default config directory.
func New() *{{.AppNamePascal}} {
	return NewWithConfig("./config")
}

// NewWithConfig creates an application with an explicit config directory.
func NewWithConfig(configPath string) *{{.AppNamePascal}} {
	return &{{.AppNamePascal}}{
		configPath: configPath,
		Core:       application.NewGRPC(configPath, "{{.AppNameUpper}}", nil),
		logger:     logger.GetLogger("{{.AppNameSnake}}"),
	}
}

// NewWithFlags creates an application with parsed command line flags.
func NewWithFlags(flags *application.AppFlags) *{{.AppNamePascal}} {
	return &{{.AppNamePascal}}{
		configPath: flags.ConfigDir,
		Core:       application.NewGRPC(flags.ConfigDir, "{{.AppNameUpper}}", flags),
		logger:     logger.GetLogger("{{.AppNameSnake}}"),
	}
}

// WithVersion sets the application version (chaining call).
func (a *{{.AppNamePascal}}) WithVersion(version string) *{{.AppNamePascal}} {
	a.Core.WithVersion(version)
	return a
}

// Run starts the application and blocks until shutdown.
func (a *{{.AppNamePascal}}) Run() error {
	a.setupCallbacks()
	return a.Core.Run()
}

// RunNonBlocking starts the application without waiting for shutdown signals.
func (a *{{.AppNamePascal}}) RunNonBlocking() error {
	a.setupCallbacks()
	return a.Core.RunNonBlocking()
}

// Shutdown stops the application gracefully.
func (a *{{.AppNamePascal}}) Shutdown() error {
	return a.Core.Shutdown()
}

// GetGRPCServer returns the gRPC server (available after startup).
func (a *{{.AppNamePascal}}) GetGRPCServer() *frameworkgrpc.Server {
	return a.Core.GetGRPCServer()
}

func (a *{{.AppNamePascal}}) setupCallbacks() {
	a.initDI()
	a.Core.OnReady(a.onReady)
	a.Core.OnShutdown(a.onShutdown)
}

// initDI registers application providers. ProvideGRPCServer wires the gRPC
// server provider into the DI container; the framework starts the server
// automatically on Run (grpc.server.enabled in config).
func (a *{{.AppNamePascal}}) initDI() {
	do.Provide(a.Core.GetInjector(), di.ProvideGRPCServer)
}
