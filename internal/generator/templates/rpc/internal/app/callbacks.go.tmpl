package app

import (
	"context"

	"github.com/KOMKZ/go-yogan-framework/application"
	"go.uber.org/zap"
)

// onReady runs after the application finishes startup. The gRPC server is
// started by the framework (grpc.server.enabled in config); register services
// here once the proto code is generated:
//
//	pb.Register{{.ServiceName}}Server(a.GetGRPCServer().GetGRPCServer(), &{{.ServiceNameLower}}Handler{})
func (a *{{.AppNamePascal}}) onReady(core *application.GRPCApplication) error {
	a.logger.InfoCtx(context.Background(), "{{.AppNamePascal}} started",
		zap.String("config_path", a.configPath))
	return nil
}

// onShutdown runs before the application stops.
func (a *{{.AppNamePascal}}) onShutdown(core *application.GRPCApplication) error {
	a.logger.InfoCtx(context.Background(), "{{.AppNamePascal}} shutting down")
	return nil
}
