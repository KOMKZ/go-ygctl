package config

import (
	"fmt"

	pkgConfig "github.com/KOMKZ/go-yogan-framework/config"
	pkgGrpc "github.com/KOMKZ/go-yogan-framework/grpc"
	"github.com/KOMKZ/go-yogan-framework/logger"
)

// {{.AppNamePascal}}Config application configuration
type {{.AppNamePascal}}Config struct {
	// App basic info
	App struct {
		Name    string `mapstructure:"name"`
		Version string `mapstructure:"version"`
		Env     string `mapstructure:"env"`
	} `mapstructure:"app"`

	// Logger config
	Logger logger.Config `mapstructure:"logger"`

	// gRPC config
	Grpc pkgGrpc.Config `mapstructure:"grpc"`

	// Convenience field
	Env string `mapstructure:"-"`
}

// Validate validates configuration
func (c *{{.AppNamePascal}}Config) Validate() error {
	// Validate gRPC Server config
	if !c.Grpc.Server.Enabled {
		return fmt.Errorf("gRPC Server must be enabled")
	}

	if c.Grpc.Server.Port < 1 || c.Grpc.Server.Port > 65535 {
		return fmt.Errorf("gRPC port must be between 1-65535, current: %d", c.Grpc.Server.Port)
	}

	return nil
}

// LoadWithLoader loads config from loader
func LoadWithLoader(loader *pkgConfig.Loader) (*{{.AppNamePascal}}Config, error) {
	var cfg {{.AppNamePascal}}Config
	if err := loader.Unmarshal(&cfg); err != nil {
		return nil, fmt.Errorf("failed to parse config: %w", err)
	}

	// Copy Env to top level
	cfg.Env = cfg.App.Env

	// Validate config
	if err := cfg.Validate(); err != nil {
		return nil, fmt.Errorf("config validation failed: %w", err)
	}

	return &cfg, nil
}
