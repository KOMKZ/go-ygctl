package main

import (
	"{{.ModuleName}}/internal/app"
	"github.com/KOMKZ/go-yogan-framework/application"
	"github.com/KOMKZ/go-yogan-framework/logger"
	"go.uber.org/zap"
)

// Version is the current {{.AppName}} version. It is injected at build time
// by scripts/build.sh via -ldflags — keep it a var, not a const (the linker
// silently ignores -X targeting consts).
var Version = "0.1.0"

// BuildTime is injected by scripts/build.sh via -ldflags.
var BuildTime = ""

// GitCommit is injected by scripts/build.sh via -ldflags.
var GitCommit = ""

func main() {
	// Parse command line flags and environment variables
	flags := application.ParseFlags("{{.AppName}}", "./config")

	// Start the gRPC application (version printed by framework)
	if err := app.NewWithFlags(flags).WithVersion(Version).Run(); err != nil {
		logger.Fatal("main", "Application start failed", zap.Error(err))
	}
}
