package service

import (
{{- if not .Pure}}
	"{{.DomainImport}}/repository"
{{- end}}
	"github.com/KOMKZ/go-yogan-framework/logger"
)

// {{.EntityPascal}}Service 领域服务：承载 {{.DomainKey}} 域的业务规则。
// 骨架不含业务逻辑，按需添加方法。
type {{.EntityPascal}}Service struct {
{{- if not .Pure}}
	repo   repository.{{.EntityPascal}}Repository
	cache {{.EntityPascal}}RowsCache
{{- end}}
	log *logger.CtxZapLogger
}

// New{{.EntityPascal}}Service creates the domain service.
func New{{.EntityPascal}}Service({{if not .Pure}}repo repository.{{.EntityPascal}}Repository, {{end}}log *logger.CtxZapLogger{{if not .Pure}}, caches ...{{.EntityPascal}}RowsCache{{end}}) *{{.EntityPascal}}Service {
{{- if .Pure}}
	return &{{.EntityPascal}}Service{log: log}
{{- else}}
	s := &{{.EntityPascal}}Service{repo: repo, log: log}
	if len(caches) > 0 {
		s.cache = caches[0]
	}
	return s
{{- end}}
}

