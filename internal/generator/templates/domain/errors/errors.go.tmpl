package errors

import (
	"net/http"

	"github.com/KOMKZ/go-yogan-framework/errcode"
)

// Module{{.DomainPascal}} 模块号：{{.DomainKey}} 域。
// 由 ygctl domain init 扫描现有域后自动分配（max+1），禁止手工修改。
const Module{{.DomainPascal}} = {{.ErrModule}}

var (
	// 业务码从 1001 递增注册；下方为示例，按需保留、修改或删除：
	Err{{.EntityPascal}}NotFound = errcode.Register(errcode.New(
		Module{{.DomainPascal}}, 1001, "{{.DomainKey}}",
		"error.{{.DomainKey}}.not_found", "{{.EntityPascal}}不存在",
		http.StatusNotFound,
	))
)
